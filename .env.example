# ==============================================================================
# ChronosEdu Environment Configuration Template
# All production variables must be configured in environment / secret manager.
# NO VALUES - Reference template only.
# ==============================================================================

# Server & Runtime
PORT=

# Database & Multi-Tenant Connection (App Role: chronos_app)
CHRONOS_DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
CHRONOS_APP_PASSWORD=

# Security & Authentication (JWT + Argon2id)
CHRONOS_JWT_SECRET=
CHRONOS_JWT_ALGORITHM=
CHRONOS_JWT_EXPIRATION_MINUTES=

# Platform Master Token (Required for Onboarding / School Creation)
CHRONOS_PLATFORM_TOKEN=

# CORS & Networking
CHRONOS_CORS_ORIGINS=

# Engine / Solver
CHRONOS_SOLVER_TIME_LIMIT_S=

# Notifications (Resend API)
RESEND_API_KEY=
CHRONOS_NOTIFICATION_FROM_EMAIL=
